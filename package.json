{
  "name": "ring-client-example",
  "version": "1.0.0",
  "description": "Example use of the `ring-client-api` npm package",
  "main": "lib/index.js",
  "scripts": {
    "start": "npm run ts-example",
    "auth": "ring-auth-cli",
    "ts-example": "tsc && node --env-file=.env lib/example.js",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "smoke": "node -e \"const {spawnSync}=require('child_process');const r=spawnSync('ring-auth-cli',['--help'],{input:'',timeout:15000,encoding:'utf8'});if(!/refresh token/.test(r.stdout||''))process.exit(1)\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dgreif/ring-client-example.git"
  },
  "bugs": {
    "url": "https://github.com/dgreif/ring-client-example/issues"
  },
  "homepage": "https://github.com/dgreif/ring-client-example#readme",
  "dependencies": {
    "ring-client-api": "^14.3.0"
  },
  "devDependencies": {
    "typescript": "^5.8.2"
  }
}
